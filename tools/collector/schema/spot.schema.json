{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hamalert.org/schema/spot.json",
  "title": "Spot",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "activity", "source", "callsign", "baseCallsign", "time", "receivedAt", "provenance", "precision"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "activity": {"type": "string", "enum": ["on-air", "qrt", "beacon", "monitoring"]},
    "source": {"type": "string", "enum": ["sotawatch", "pota", "wwff", "cluster", "rbn", "pskreporter", "quadnet", "ircddb", "dstarusers", "amsat", "simulator"]},
    "sourceId": {"type": "string"},
    "client": {"type": "string"},
    "callsign": {"type": "string", "pattern": "^[A-Z0-9/]{3,20}$"},
    "baseCallsign": {"type": "string", "pattern": "^[A-Z0-9]{3,12}$"},
    "spotter": {
      "type": "object", "additionalProperties": false, "required": ["callsign", "kind", "isSelf"],
      "properties": {
        "callsign": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["human", "skimmer", "bot", "gateway"]},
        "relay": {"type": "string"},
        "isSelf": {"type": "boolean"},
        "entity": {"$ref": "#/definitions/entity"},
        "state": {"type": "string"},
        "locator": {"type": "string"}
      }
    },
    "time": {"type": "string", "format": "date-time"},
    "receivedAt": {"type": "string", "format": "date-time"},
    "frequency": {"type": "integer", "minimum": 1},
    "band": {"type": "string", "pattern": "^[0-9.]+(m|cm|mm)(_[a-z0-9]+)?$"},
    "mode": {"type": "string", "pattern": "^[a-z0-9 /.-]+$"},
    "modeDetail": {"type": "string"},
    "comment": {"type": "string"},
    "rawText": {"type": "string"},
    "entity": {"$ref": "#/definitions/entity"},
    "homeEntity": {"$ref": "#/definitions/entity"},
    "states": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{2}_[A-Z0-9]{2,3}$"}},
    "qsl": {"type": "array", "items": {"type": "string", "enum": ["lotw", "eqsl"]}},
    "summit": {
      "type": "object", "additionalProperties": false, "required": ["program", "ref", "association", "region"],
      "properties": {
        "program": {"type": "string", "enum": ["sota"]},
        "ref": {"type": "string", "pattern": "^[A-Z0-9]{1,8}/[A-Z]{2}-[0-9]{3}$"},
        "association": {"type": "string"}, "region": {"type": "string"},
        "name": {"type": "string"}, "altitude": {"type": "integer"}, "points": {"type": "integer"},
        "activationCount": {"type": "integer"}, "valid": {"type": "boolean"},
        "latitude": {"type": "number"}, "longitude": {"type": "number"}
      }
    },
    "parks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["program", "ref", "prefix"],
        "properties": {
          "program": {"type": "string", "enum": ["pota", "wwff"]},
          "ref": {"type": "string", "pattern": "^[A-Z0-9]{1,5}-[0-9]{4,5}$"},
          "prefix": {"type": "string"}, "name": {"type": "string"},
          "locations": {"type": "array", "items": {"type": "string"}},
          "latitude": {"type": "number"}, "longitude": {"type": "number"}
        }
      }
    },
    "iota": {"type": "object", "additionalProperties": false, "required": ["ref"],
      "properties": {"ref": {"type": "string", "pattern": "^(AF|AN|AS|EU|NA|OC|SA)-[0-9]{3}$"}, "name": {"type": "string"}}},
    "signal": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "snr": {"type": "integer"}, "speed": {"type": "integer"}, "speedUnit": {"type": "string", "enum": ["wpm", "bps"]},
        "spotType": {"type": "string", "enum": ["cq", "dx", "beacon", "ncdxf"]},
        "senderLocator": {"type": "string"}, "software": {"type": "string"}, "spotterCount": {"type": "integer"}
      }
    },
    "dstar": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "node": {"type": "string", "pattern": "^[A-Z0-9]{3,8}(-[A-Z])?$"},
        "gateway": {"type": "string"},
        "reflector": {"type": "string", "pattern": "^[A-Z]{3}[0-9A-Z]{3}(-[A-Z])?$"},
        "group": {"type": "string"}, "groupName": {"type": "string"},
        "duration": {"type": "number", "minimum": 0}, "suffix": {"type": "string", "maxLength": 4},
        "ber": {"type": "number"}, "silencePct": {"type": "number"}
      }
    },
    "satellite": {"type": "object"},
    "cluster": {
      "type": "object", "additionalProperties": false,
      "properties": {"node": {"type": "string"}, "commentTruncated": {"type": "boolean"}, "format": {"type": "string", "enum": ["classic", "cc11"]}}
    },
    "provenance": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-z-]+$"}},
    "precision": {"type": "object", "additionalProperties": false,
      "properties": {"time": {"type": "string", "enum": ["minute"]}, "frequency": {"type": "string", "enum": ["khz"]}}}
  },
  "definitions": {
    "entity": {"type": "object", "additionalProperties": false, "required": ["dxcc", "name"],
      "properties": {"dxcc": {"type": "integer"}, "name": {"type": "string"}, "continent": {"type": "string"}, "cq": {"type": "integer"}, "itu": {"type": "integer"}}}
  }
}
